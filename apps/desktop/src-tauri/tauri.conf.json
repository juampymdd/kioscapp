{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KioscApp",
  "version": "0.1.0",
  "identifier": "com.kioscapp.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KioscApp",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "REEMPLAZAR_CON_CLAVE_PUBLICA",
      "endpoints": [
        "https://github.com/juampymdd/kioscapp/releases/latest/download/latest.json"
      ]
    }
  }
}
